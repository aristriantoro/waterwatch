# ============================================================
# WaterWatch – Variabel Lingkungan
# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke git
# ============================================================

# URL koneksi database PostgreSQL
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://waterwatch:waterwatch_secret@postgres:5432/waterwatch

# Secret untuk signing JWT (ganti dengan string acak >=32 karakter di produksi)
JWT_SECRET=ganti_ini_dengan_secret_panjang_dan_acak_minimal_32_karakter

# Masa berlaku JWT dalam detik (3600 = 1 jam)
JWT_EXPIRY_SECONDS=3600

# Folder penyimpanan foto (relatif dari root project)
UPLOAD_DIR=/app/uploads

# Ukuran maksimum upload foto dalam byte (5242880 = 5 MB)
MAX_UPLOAD_BYTES=5242880

# Port server backend (di dalam container)
SERVER_PORT=8080

# Origin yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Level logging (trace, debug, info, warn, error)
RUST_LOG=waterwatch=info,tower_http=info

