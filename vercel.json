{
  "version": 2,
  "public": false,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://BACKEND_URL_PLACEHOLDER/api/$1" },
    { "source": "/health", "destination": "https://BACKEND_URL_PLACEHOLDER/health" },
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/warga/(.*)", "destination": "/static/warga/$1" },
    { "source": "/admin/(.*)", "destination": "/static/admin/$1" },
    { "source": "/login", "destination": "/static/login.html" },
    { "source": "/register", "destination": "/static/register.html" },
    { "source": "/login.html", "destination": "/static/login.html" },
    { "source": "/register.html", "destination": "/static/register.html" },
    { "source": "/", "destination": "/static/index.html" }
  ]
}
